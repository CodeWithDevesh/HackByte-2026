# Speech server network
SPEECH_HOST=0.0.0.0
SPEECH_PORT=8000

# TTS provider strategy: piper | hybrid | auto
TTS_BACKEND=piper

# Piper local voice assets
PIPER_MODEL_PATH=assets/tts_models/en_US-lessac-medium.onnx
PIPER_CONFIG_PATH=assets/tts_models/en_US-lessac-medium.onnx.json
SPEECH_TMP_WAV=temp_speech.wav

# Optional cloud TTS credentials (required for hybrid/auto ElevenLabs path)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Model orchestration
ENABLED_MODELS=face_recognition,weapon_detection

# When both face + weapon are enabled: one camera + one OpenCV window (Unified Vision).
# Set to 0 to force separate windows (legacy two-thread mode).
UNIFIED_CAMERA=1

# Unified mode uses face camera probing / CAMERA_INDEX (align WEAPON_CAMERA_INDEX for standalone runs).
CAMERA_INDEX=0

# Weapon detection model settings
WEAPON_MODEL_PATH=assets/weapon_detection/best.pt
WEAPON_CAMERA_INDEX=0
WEAPON_CONF_THRESHOLD=0.5
WEAPON_ALERT_COOLDOWN=2.0
WEAPON_FRAME_THRESHOLD=5
